DB_URL=jdbc:mysql://localhost:3306/zipin_mvp?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# Configure these after creating a Telegram OIDC app/bot and registering the callback URL.
TELEGRAM_OIDC_ENABLED=false
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:5173/api/auth/telegram/callback/telegram
APP_FRONTEND_URL=http://localhost:5173/

# Generate a random 32-byte value and Base64-encode it. Never reuse the Telegram client secret.
ZIPIN_JWT_SECRET=
AUTH_COOKIE_SECURE=false
